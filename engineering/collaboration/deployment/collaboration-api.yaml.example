# Inert candidate: outside .mainsequence/workflows. Not platform-validated or approved.
# Validate target branch and access, then obtain user approval before activation.
api_version: "3.0.0"
name: collaboration-api
resources:
  - key: collaboration
    kind: fastapi
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      source_path: api/erp/collaboration/main.py
      mcp_enabled: false
      cpu_request: "0.5"
      memory_request: 1Gi
      spot: false
      automatic_deployment: true
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-collaboration$'
      revision_retention_count: 3
  - key: migrate-collaboration
    kind: job
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      name: Collaboration migrations
      description: Apply only Collaboration migrations before Collaboration API activation.
      execution_path: jobs/erp/collaboration/migrate.py
      cpu_request: "0.5"
      memory_request: "1"
      max_runtime_seconds: 1800
      spot: false
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-collaboration$'
execution:
  steps:
    image:
      prepare_image: collaboration
    migrate:
      run_job: migrate-collaboration
      image_from: image
      needs: [image]
    deploy_api:
      deploy: collaboration
      image_from: image
      needs: [migrate]
