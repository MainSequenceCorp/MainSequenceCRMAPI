# Superseded by the shared ERP API in .mainsequence/workflows/crm-api.yaml.
# Historical example retained outside the workflow directory.
# Inert candidate: outside .mainsequence/workflows. Not platform-validated or approved.
# Validate target branch and access, then obtain user approval before activation.
api_version: "3.0.0"
name: manufacturing-api
resources:
  - key: manufacturing
    kind: fastapi
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      source_path: api/erp/manufacturing/main.py
      mcp_enabled: false
      cpu_request: "0.5"
      memory_request: 1Gi
      spot: false
      automatic_deployment: true
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-manufacturing$'
      revision_retention_count: 3
  - key: migrate-manufacturing
    kind: job
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      name: Manufacturing migrations
      description: Apply only Manufacturing migrations before Manufacturing API activation.
      execution_path: jobs/erp/manufacturing/migrate.py
      cpu_request: "0.5"
      memory_request: "1"
      max_runtime_seconds: 1800
      spot: false
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-manufacturing$'
execution:
  steps:
    image:
      prepare_image: manufacturing
    migrate:
      run_job: migrate-manufacturing
      image_from: image
      needs: [image]
    deploy_api:
      deploy: manufacturing
      image_from: image
      needs: [migrate]
