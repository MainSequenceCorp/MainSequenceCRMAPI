# Inert candidate: outside .mainsequence/workflows. Not platform-validated or approved.
# Validate target branch and access, then obtain user approval before activation.
api_version: "3.0.0"
name: marketing-api
resources:
  - key: marketing
    kind: fastapi
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      source_path: api/erp/marketing/main.py
      mcp_enabled: false
      cpu_request: "0.5"
      memory_request: 1Gi
      spot: false
      automatic_deployment: true
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-marketing$'
      revision_retention_count: 3
  - key: migrate-marketing
    kind: job
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      name: Marketing migrations
      description: Apply only Marketing migrations before Marketing API activation.
      execution_path: jobs/erp/marketing/migrate.py
      cpu_request: "0.5"
      memory_request: "1"
      max_runtime_seconds: 1800
      spot: false
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-marketing$'
execution:
  steps:
    image:
      prepare_image: marketing
    migrate:
      run_job: migrate-marketing
      image_from: image
      needs: [image]
    deploy_api:
      deploy: marketing
      image_from: image
      needs: [migrate]
