# Superseded by the shared ERP API in .mainsequence/workflows/crm-api.yaml.
# Historical example retained outside the workflow directory.
# Inert candidate: outside .mainsequence/workflows. Not platform-validated or approved.
# Validate target branch and access, then obtain user approval before activation.
api_version: "3.0.0"
name: people-api
resources:
  - key: people
    kind: fastapi
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      source_path: api/erp/people/main.py
      mcp_enabled: false
      cpu_request: "0.5"
      memory_request: 1Gi
      spot: false
      automatic_deployment: true
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-people$'
      revision_retention_count: 3
  - key: migrate-people
    kind: job
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      name: People migrations
      description: Apply only People migrations before People API activation.
      execution_path: jobs/erp/people/migrate.py
      cpu_request: "0.5"
      memory_request: "1"
      max_runtime_seconds: 1800
      spot: false
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-people$'
execution:
  steps:
    image:
      prepare_image: people
    migrate:
      run_job: migrate-people
      image_from: image
      needs: [image]
    deploy_api:
      deploy: people
      image_from: image
      needs: [migrate]
