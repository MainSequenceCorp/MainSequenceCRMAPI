# Inert candidate: outside .mainsequence/workflows. Not platform-validated or approved.
# Validate target branch and access, then obtain user approval before activation.
api_version: "3.0.0"
name: projects-api
resources:
  - key: projects
    kind: fastapi
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      source_path: api/erp/projects/main.py
      mcp_enabled: false
      cpu_request: "0.5"
      memory_request: 1Gi
      spot: false
      automatic_deployment: true
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-projects$'
      revision_retention_count: 3
  - key: migrate-projects
    kind: job
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      name: Projects migrations
      description: Apply only Projects migrations before Projects API activation.
      execution_path: jobs/erp/projects/migrate.py
      cpu_request: "0.5"
      memory_request: "1"
      max_runtime_seconds: 1800
      spot: false
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-projects$'
execution:
  steps:
    image:
      prepare_image: projects
    migrate:
      run_job: migrate-projects
      image_from: image
      needs: [image]
    deploy_api:
      deploy: projects
      image_from: image
      needs: [migrate]
