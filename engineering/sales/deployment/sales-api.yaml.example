# Inert candidate: outside .mainsequence/workflows. Not platform-validated or approved.
# Validate target branch and access, then obtain user approval before activation.
api_version: "3.0.0"
name: sales-api
resources:
  - key: sales
    kind: fastapi
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      source_path: api/erp/sales/main.py
      mcp_enabled: false
      cpu_request: "0.5"
      memory_request: 1Gi
      spot: false
      automatic_deployment: true
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-sales$'
      revision_retention_count: 3
  - key: migrate-sales
    kind: job
    access:
      branches:
        - repository: MetaTables
          policy: reader
    spec:
      name: Sales migrations
      description: Apply only Sales migrations before Sales API activation.
      execution_path: jobs/erp/sales/migrate.py
      cpu_request: "0.5"
      memory_request: "1"
      max_runtime_seconds: 1800
      spot: false
      automatic_redeployment:
        enabled: true
        tag_regex: '^v[0-9]+[.][0-9]+[.][0-9]+-sales$'
execution:
  steps:
    image:
      prepare_image: sales
    migrate:
      run_job: migrate-sales
      image_from: image
      needs: [image]
    deploy_api:
      deploy: sales
      image_from: image
      needs: [migrate]
